<Page x:Class="mangapp.GestionUtilisateur"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:mangapp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GestionUtilisateur">

    <Grid Margin="0,0,0,-530">
        <Border Width="437"
            Height="803"
            Background="#F8F9FF"
            CornerRadius="12"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="118,173,0,0">

            <!-- Le StackPanel contient maintenant vos TextBlock de navigation ET votre formulaire -->
            <StackPanel Margin="10">

                <!-- ================= NAVBAR (TEXTBLOC CLIQUABLES) ================= -->
                <TextBlock Text="Accueil" 
                       FontFamily="Segoe UI" 
                       FontSize="14" 
                       Foreground="#2C3E50"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,10"/>



                <!-- Ligne de séparation sous votre navbar -->
                <Separator Background="Black" Margin="0,0,0,15"/>


                <!-- ================= VOTRE FORMULAIRE D'ORIGINE ================= -->
                <!-- Élément 1 : Votre texte de titre -->

                <TextBlock Text="Recherche" 
                       FontFamily="Segoe UI" 
                       FontSize="16" 
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

                <!-- Élément 2 : Première zone de saisie (ex: Nom) -->
                <TextBlock  Text="Nom de l'utilisateur :" 
       FontFamily="Segoe UI" 
       FontSize="12" 
       Foreground="#555555" 
       Margin="10,0,0,2" />
                <TextBox Width="93" Name="TxtRechercher" Text=""
                     Height="30" 
                     Margin="0,0,0,10"
                     VerticalContentAlignment="Center"/>
                <Button Content="Rechercher" Width="200" Height="30" Margin="10" Click="BoutonRechercher_Click" />

                <!-- Élément 3 : Deuxième zone de saisie (ex: Prénom) -->
                <TextBlock Text="Role :" 
       FontFamily="Segoe UI" 
       FontSize="12" 
       Foreground="#555555" 
       Margin="10,0,0,2" />
                <TextBox Width="93" x:Name="TxtAuteur" Text=""
                         Height="30"
                         VerticalContentAlignment="Center"/>
                <Button Content="Rechercher" Width="200" Height="30" Margin="10" Click="BoutonRechercherAuteur_Click" />


                <Separator Background="White" Margin="0,0,0,15"/>



                <Separator Background="Black" Margin="0,0,0,15"/>



                <Button Content="Afficher tous les utilisateurs" Width="200" Height="30" Margin="10" Click="BtnAfficherTous_Click" />
                <ListBox x:Name="LstMangas"
         Width="350"
         Height="250"
         HorizontalContentAlignment="Stretch"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Même affichage qu'avant (ToString de Utilisateurs) -->
                                <TextBlock Grid.Column="0"
                           Text="{Binding}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                                <Button Grid.Column="1"
                        Content="Changer rôle"
                        Margin="8,0,0,0"
                        Padding="8,2"
                        Click="ChangerRole_Click"
                        Loaded="BtnChangerRole_Loaded"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
                <Button x:Name="BtnSupprimer" Content="Supprimer le compte" Click="SupprimerUtilisateur_Click" Height="30" Width="200"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>

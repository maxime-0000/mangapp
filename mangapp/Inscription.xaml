<Page x:Class="mangapp.Inscription"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:mangapp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Inscription">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="149*"/>
            <RowDefinition Height="76*"/>
        </Grid.RowDefinitions>
        <Border Width="238"
                Height="440"
                Background="#F8F9FF"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Top" Margin="0,48,0,0" Grid.RowSpan="2">

            <!-- Le StackPanel contient maintenant vos TextBlock de navigation ET votre formulaire -->
            <StackPanel Margin="10">

                <!-- ================= NAVBAR (TEXTBLOC CLIQUABLES) ================= -->

                <!-- ================= NAVBAR (TEXTBLOC CLIQUABLES) ================= -->
                <TextBlock Text="Inscription"
                           FontFamily="Segoe UI" 
                           FontSize="14" 
                           Foreground="#2C3E50"
                           Cursor="Hand" Width="68" Height="20"
                           ><Run Language="fr-fr" Text="Inscription"/><LineBreak/><Run Language="fr-fr"/></TextBlock>
                <!-- Ligne de séparation sous votre navbar -->
                <Separator Background="#E0E0E0" Margin="0,0,0,15"/>


                <!-- Élément 1 : Votre texte de titre -->
                <TextBlock Text="Utilisateur" 
                           FontFamily="Segoe UI" 
                           FontSize="16" 
                           Foreground="#333333"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <!-- Élément 2 : Première zone de saisie (ex: Nom) -->
                <TextBox x:Name="Nom" Width="93" Text=""
                         Height="30" 
                         Margin="0,0,0,10"
                         VerticalContentAlignment="Center" TextChanged="Nom_Utilisateur"/>

                <TextBlock Text="Mot de Passe" 
                           FontFamily="Segoe UI"
                           FontSize="16" 
                           Foreground="#333333"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>
                <PasswordBox x:Name="Mot_de_Passe" HorizontalAlignment="Center" 
                             Margin="0,0,0,10" 
                             VerticalAlignment="Top" 
                             Width="120" PasswordChanged="MDP_Utilisateur"/>

                <!-- Élément 2 : Première zone de saisie (ex: Nom) -->

                <TextBlock Text="Confirmation de Mot de Passe" 
                            FontFamily="Segoe UI"
                            FontSize="16" 
                            Foreground="#333333"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,15" Width="217"/>
                <PasswordBox x:Name="Confirmation" HorizontalAlignment="Center" 
                             Margin="0,0,0,10" 
                             VerticalAlignment="Top" 
                             Width="120" PasswordChanged="Confirmation_Utilisateur"/>

                <!-- Élément 3 : Deuxième zone de saisie (ex: Prénom) -->

                <TextBlock Text="Mail" 
                            FontFamily="Segoe UI" 
                            FontSize="16" 
                            Foreground="#333333"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,15"/>

                <!-- Élément 2 : Première zone de saisie (ex: Nom) -->
                <TextBox x:Name="Mail" Width="93" Text=""
                         Height="30" 
                         Margin="0,0,0,10"
                         VerticalContentAlignment="Center" TextChanged="Mail_Utilisateur"/>
                <Button Content="Creer" 
                        Width="37" Click="Button_Creer"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>

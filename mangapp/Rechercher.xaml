<Page x:Class="mangapp.Rechercher"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:mangapp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Rechercher">


	<Grid>
		<Border Width="407"
                Height="803"
                Background="#F8F9FF"
                CornerRadius="12"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="118,173,0,0">

			<!-- Le StackPanel contient maintenant vos TextBlock de navigation ET votre formulaire -->
			<StackPanel Margin="10">

				<!-- ================= NAVBAR (TEXTBLOC CLIQUABLES) ================= -->
				<TextBlock Text="Accueil" 
                           FontFamily="Segoe UI" 
                           FontSize="14" 
                           Foreground="#2C3E50"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,10"/>



				<!-- Ligne de séparation sous votre navbar -->
				<Separator Background="Black" Margin="0,0,0,15"/>


				<!-- ================= VOTRE FORMULAIRE D'ORIGINE ================= -->
				<!-- Élément 1 : Votre texte de titre -->

				<TextBlock Text="Recherche" 
                           FontFamily="Segoe UI" 
                           FontSize="16" 
                           Foreground="#333333"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

				<!-- Élément 2 : Première zone de saisie (ex: Nom) -->
				<TextBlock Text="Nom du manga :" 
           FontFamily="Segoe UI" 
           FontSize="12" 
           Foreground="#555555" 
           Margin="10,0,0,2" />
				<TextBox Width="93" Text=""
                         Height="30" 
                         Margin="0,0,0,10"
                         VerticalContentAlignment="Center"/>

				<!-- Élément 3 : Deuxième zone de saisie (ex: Prénom) -->
				<TextBlock Text="Auteur :" 
           FontFamily="Segoe UI" 
           FontSize="12" 
           Foreground="#555555" 
           Margin="10,0,0,2" />
				<TextBox Width="93" Text=""
                         Height="30"
                         VerticalContentAlignment="Center"/>

				<Separator Background="White" Margin="0,0,0,15"/>

				<Separator Background="Black" Margin="0,0,0,15"/>

				<TextBlock Text="Populaire" 
           FontFamily="Segoe UI" 
           FontSize="16" 
           Foreground="#333333"
           HorizontalAlignment="Center"
           Margin="0,0,0,15"/>

				<Separator Background="Black" Margin="0,0,0,15"/>

				<TextBlock Text="Peu en stock" 
           FontFamily="Segoe UI" 
           FontSize="16" 
           Foreground="#333333"
           HorizontalAlignment="Center"
           Margin="0,0,0,15"/>


			</StackPanel>
		</Border>
	</Grid>

</Page>

<Window x:Class="mangapp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MangAPP"
        Width="900"
        Height="1000"
        MinWidth="700"
        MinHeight="750"
        WindowStartupLocation="CenterScreen"
        Background="#1989E9">

	<Viewbox Stretch="Uniform">
		<Grid Width="768" Height="1024"
              Background="#1989E9">

			<!-- Fond rose en diagonale -->
			<Polygon Points="768,0 768,1024 0,1024"
                     Fill="#FF2164"/>

			<!-- Titre principal -->
			<TextBlock Text="MANGAPP"
                       FontFamily="Impact"
                       FontSize="72"
                       FontWeight="Black"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,15,0,0"/>

			<!-- Grand rectangle blanc -->
			<Border Width="437"
                    Height="803"
                    Background="#F8F9FF"
                    CornerRadius="12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="310,173,0,0"/>

			<!-- Menu de navigation -->
			<StackPanel Width="230"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="0,204,0,0">

				<!-- Rechercher -->
				<Grid Height="109"
                      Margin="0,0,0,32">

					<Polygon Points="0,0 173,0 230,54 173,109 0,109"
                             Fill="#F8F9FF"/>

					<TextBlock Text="RECHERCHER"
                               FontFamily="Impact"
                               FontSize="23"
                               Foreground="Black"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>

				</Grid>

				<!-- Stock -->
				<Grid Height="109"
                      Margin="0,0,0,32">

					<Polygon Points="0,0 173,0 230,54 173,109 0,109"
                             Fill="#F8F9FF"/>

					<TextBlock Text="STOCK"
                               FontFamily="Impact"
                               FontSize="23"
                               Foreground="Black"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>

				</Grid>

				<!-- Statistiques -->
				<Grid Height="109"
                      Margin="0,0,0,32">

					<Polygon Points="0,0 173,0 230,54 173,109 0,109"
                             Fill="#F8F9FF"/>

					<TextBlock Text="STATISTIQUES"
                               FontFamily="Impact"
                               FontSize="23"
                               Foreground="Black"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>

				</Grid>

				<!-- Inscription -->
				<Grid Height="109">

					<Polygon Points="0,0 173,0 230,54 173,109 0,109"
                             Fill="#F8F9FF"/>

					<TextBlock Text="INSCRIPTION"
                               FontFamily="Impact"
                               FontSize="23"
                               Foreground="Black"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>

				</Grid>

			</StackPanel>

			<!-- Logo MangAPP en bas à gauche -->
			<Image Source="Images/logo.png"
                   Width="210"
                   Height="160"
                   Stretch="Uniform"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="10,0,0,55"/>


			<Grid>
				<Grid.ColumnDefinitions>
					<!-- Colonne pour la navbar latérale -->
					<ColumnDefinition Width="200"/>
					<!-- Zone de contenu principal -->
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!-- Barre de navigation latérale -->
				<StackPanel Grid.Column="0" Background="#2C3E50">
					<!-- Logo ou Titre -->
					<TextBlock Text="Mon App" Foreground="White" FontSize="20" Margin="20" HorizontalAlignment="Center"/>

					<!-- Boutons de navigation -->
					<Button Content="Accueil" Click="BtnAccueil" Background="Transparent" Foreground="White" BorderThickness="0" Padding="15"/>

					<Button Content="Rechercher" Click="BtnRechercher" Background="Transparent" Foreground="White" BorderThickness="0" Padding="15"/>

					<Button Content="Statistique" Click="BtnStats" Background="Transparent" Foreground="White" BorderThickness="0" Padding="15"/>

					<Button Content="Inscrpition" Click="BtnInscription" Background="Transparent" Foreground="White" BorderThickness="0" Padding="15"/>


				</StackPanel>

				<!-- Contenu dynamique à droite -->
				<Frame Grid.Column="1" NavigationUIVisibility="Hidden" Name="MainFrame"/>
			</Grid>




		</Grid>
	</Viewbox>

</Window>
<Page x:Class="mangapp.Connexion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:mangapp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Connexion">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="149*"/>
            <RowDefinition Height="76*"/>
        </Grid.RowDefinitions>
        <Border Width="407"
        Height="803"
        Background="#F8F9FF"
        CornerRadius="12"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="118,173,0,0">

            <!-- Le StackPanel contient maintenant vos TextBlock de navigation ET votre formulaire -->
            <StackPanel Margin="10">

                <!-- ================= NAVBAR (TEXTBLOC CLIQUABLES) ================= -->

                <!-- ================= NAVBAR (TEXTBLOC CLIQUABLES) ================= -->
                <!-- Ligne de séparation sous votre navbar -->
                <!-- ================= NAVBAR (TEXTBLOC CLIQUABLES) ================= -->
                <TextBlock Text="Connexion"
                       FontFamily="Segoe UI" 
                       FontSize="14" 
                       Foreground="#2C3E50"
                       Cursor="Hand" Width="68" Height="20"/>
                <!-- Ligne de séparation sous votre navbar -->
                <Separator Background="#E0E0E0" Margin="0,0,0,15"/>


                <!-- Élément 1 : Votre texte de titre -->
                <TextBlock Text="Mail"
                       FontFamily="Segoe UI" 
                       FontSize="16" 
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>
                <TextBox x:Name="Mail" Width="94" Text=""
                        Height="16" 
                        Margin="0,0,0,10"
                        VerticalContentAlignment="Center" TextChanged="Mail_Utilisateur"/>

                <TextBlock Text="Mot de Passe" 
                       FontFamily="Segoe UI"
                       FontSize="16" 
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>
                <PasswordBox x:Name="Mot_de_Passe" HorizontalAlignment="Center" 
                         Margin="0,0,0,10" 
                         VerticalAlignment="Top" 
                         Width="120" 
                         PasswordChanged="MDP_Utilisateur"/>
                <Button Content="Valider" 
                    Width="45" Click="Button_Valider"/>
           </StackPanel>
        </Border>
    </Grid>
</Page>

<Page x:Class="mangapp.Statistique"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:mangapp"
      mc:Ignorable="d"
      d:DesignHeight="900"
      d:DesignWidth="1200"
      Title="Statistique">

    <Grid Background="Transparent">

        <Border Width="407"
                Height="803"
                Background="#F8F9FF"
                CornerRadius="12"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="118,173,0,0">

            <StackPanel Margin="8">

                <!-- ================================================= -->
                <!-- TITRE -->
                <!-- ================================================= -->

                <TextBlock Text="Statistiques"
                           FontFamily="Segoe UI"
                           FontSize="38"
                           Foreground="#2C3E50"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <Separator Background="#E0E0E0"
                           Margin="0,0,0,12"/>


                <!-- ================================================= -->
                <!-- MANGAS -->
                <!-- ================================================= -->

                <TextBlock Text="Stock des mangas"
                           FontFamily="Segoe UI"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           Margin="0,0,0,8"/>


                <!-- Recherche d'un manga précis -->

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">

                    <TextBlock Text="ID Manga :"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <TextBox x:Name="txtIdManga"
                             Width="90"
                             Height="28"
                             VerticalContentAlignment="Center"
                             Margin="0,0,10,0"/>

                    <Button Content="Vérifier le stock"
                            Width="135"
                            Height="30"
                            Click="VerifierManga_Click"/>

                </StackPanel>


                <!-- Résultat manga précis -->

                <TextBlock x:Name="lblStockManga"
                           Text=""
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>


                <!-- Vue globale mangas -->

                <Button Content="Vue globale des mangas"
                        Width="188"
                        Height="30"
                        HorizontalAlignment="Left"
                        Click="AfficherMangas_Click"
                        Margin="0,0,0,8"/>


                <DataGrid x:Name="dgMangas"
                          Height="185"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          Margin="0,0,0,12"/>


                <!-- ================================================= -->
                <!-- ZONES -->
                <!-- ================================================= -->

                <Separator Background="#E0E0E0"
                           Margin="0,0,0,12"/>


                <TextBlock Text="Stock des zones"
                           FontFamily="Segoe UI"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           Margin="0,0,0,8"/>


                <!-- Recherche d'une zone précise -->

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">

                    <TextBlock Text="ID Zone :"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <TextBox x:Name="txtIdZone"
                             Width="90"
                             Height="28"
                             VerticalContentAlignment="Center"
                             Margin="0,0,10,0"/>

                    <Button Content="Vérifier le stock"
                            Width="135"
                            Height="30"
                            Click="VerifierZone_Click"/>

                </StackPanel>


                <!-- Résultat zone précise -->

                <TextBlock x:Name="lblStockZone"
                           Text=""
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>


                <!-- Vue globale zones -->

                <Button Content="Vue globale des zones"
                        Width="188"
                        Height="30"
                        HorizontalAlignment="Left"
                        Click="AfficherZones_Click"
                        Margin="0,0,0,8"/>


                <DataGrid x:Name="dgZones"
                          Height="185"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"/>

            </StackPanel>

        </Border>

    </Grid>

</Page>
<Page x:Class="mangapp.PageHistorique"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Historique">
    <Grid Background="Transparent">
        <Border Width="437" Height="803" Background="#F8F9FF" CornerRadius="12"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="118,173,0,0">
            <StackPanel Margin="8">
                <TextBlock Text="Historique" FontFamily="Segoe UI" FontSize="38"
                           Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <Separator Background="#E0E0E0" Margin="0,0,0,12"/>
                <Button Content="Actualiser" Width="150" Height="30"
                        HorizontalAlignment="Left" Click="Actualiser_Click" Margin="0,0,0,8"/>
                <DataGrid x:Name="dgHistorique" Height="650" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}"/>
                        <DataGridTextColumn Header="Manga" Binding="{Binding NomManga}"/>
                        <DataGridTextColumn Header="Mouvement" Binding="{Binding Type_mouvement}"/>
                        <DataGridTextColumn Header="Qté" Binding="{Binding Quantite}"/>
                        <DataGridTextColumn Header="Manager" Binding="{Binding NomManager}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
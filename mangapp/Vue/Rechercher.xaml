<Page x:Class="mangapp.Rechercher"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:mangapp"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="Rechercher">

    <Grid Margin="0,0,0,-537">

        <Border Width="437"
                Height="803"
                Background="#F8F9FF"
                CornerRadius="12"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="118,173,0,0">

            <StackPanel Margin="10">

				<!-- ================= NAVBAR (TEXTBLOC CLIQUABLES) ================= -->
				<TextBlock Text="Recherche" 
                           FontFamily="Segoe UI" 
                           FontSize="14" 
                           Foreground="#2C3E50"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,10"/>

                <Separator Background="Black"
                           Margin="0,0,0,15"/>

                <!-- TITRE -->

                <TextBlock Text="Recherche"
                           FontFamily="Segoe UI"
                           FontSize="16"
                           Foreground="#333333"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <!-- CHOIX DU FILTRE -->

                <TextBlock Text="Rechercher par :"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="#555555"
                           Margin="10,0,0,5"/>

                <ComboBox x:Name="CmbFiltre"
                          Width="250"
                          Height="30"
                          SelectedIndex="0"
                          Margin="0,0,0,15">

                    <ComboBoxItem Content="Nom du manga"/>
                    <ComboBoxItem Content="Auteur"/>
                    <ComboBoxItem Content="Tome"/>
                    <ComboBoxItem Content="Genre"/>
                    <ComboBoxItem Content="Éditeur"/>
                    <ComboBoxItem Content="Année de publication"/>

                </ComboBox>

                <!-- BARRE DE RECHERCHE UNIQUE -->

                <TextBlock Text="Votre recherche :"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="#555555"
                           Margin="10,0,0,5"/>

                <TextBox x:Name="TxtRechercher"
                         Width="250"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,10"/>

                <!-- BOUTON RECHERCHER -->

                <Button Content="Rechercher"
                        Width="200"
                        Height="30"
                        Margin="10"
                        Click="BoutonRechercher_Click"/>

                <Separator Background="Black"
                           Margin="0,10,0,15"/>

                <!-- AFFICHER TOUS LES MANGAS -->

                <Button Content="Afficher tous les mangas"
                        Width="200"
                        Height="30"
                        Margin="10"
                        Click="BtnAfficherTous_Click"/>

                <!-- RESULTATS -->

                <ListBox x:Name="LstMangas"
                         Height="400"
                         Margin="1"
                         BorderThickness="0"
                         BorderBrush="Transparent"
                         Background="Transparent"/>

            </StackPanel>

        </Border>

    </Grid>

</Page>